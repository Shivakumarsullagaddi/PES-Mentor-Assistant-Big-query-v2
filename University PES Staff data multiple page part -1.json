    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  // Universal NA handler\n  const getValue = (val) => {\n    if (val === undefined || val === null) return \"N/A\";\n    if (typeof val === \"string\" && val.trim() === \"\") return \"N/A\";\n    return val;\n  };\n\n  // Clean text (remove \\n)\n  const cleanText = (val) => {\n    val = getValue(val);\n    if (val === \"N/A\") return val;\n    return val.replace(/(\\r\\n|\\n|\\r)/g, \" \").trim();\n  };\n\n  // Format list safely\n  const formatNumbered = (val) => {\n    if (!val) return \"N/A\";\n\n    let arr = [];\n\n    if (Array.isArray(val)) {\n      arr = val.flat(Infinity);\n    } else if (typeof val === \"object\") {\n      arr = Object.values(val);\n    } else {\n      return getValue(val);\n    }\n\n    if (!arr.length) return \"N/A\";\n\n    return arr\n      .map((v, i) => {\n        if (typeof v === \"object\" && v !== null) {\n          v = Object.values(v).join(\" \");\n        }\n        v = getValue(v);\n        return v === \"N/A\" ? null : `${i + 1}. ${v}`;\n      })\n      .filter(v => v !== null)\n      .join(\"\\n\") || \"N/A\";\n  };\n\n  const baseUrl = \"https://staff.pes.edu\";\n\n  // Image fix\n  let imageUrl = \"N/A\";\n  if (item.json.image) {\n    imageUrl = item.json.image.startsWith(\"http\")\n      ? item.json.image\n      : baseUrl + item.json.image;\n  }\n\n  return {\n    json: {\n      name: getValue(item.json.name),\n      designation: getValue(item.json.designation),\n\n      department: getValue(item.json.department),\n      campus: cleanText(item.json.campus),\n\n      research: formatNumbered(item.json.research),\n      teaching: formatNumbered(item.json.teaching),\n\n      about: getValue(item.json.about),\n\n      publications_journals: formatNumbered(item.json.publications_journals),\n      publications_conferences: formatNumbered(item.json.publications_conferences),\n\n      education: formatNumbered(item.json.education),\n\n      mail: getValue(item.json.mail || item.json.Mail),\n      phone: getValue(item.json.phone || item.json.Phone),\n\n      responsibilities: formatNumbered(item.json.responsibilities),\n\n      image: imageUrl\n    }\n  };\n});"
      },
